{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lowyap",
  "mainBinaryName": "lowyap",
  "version": "0.1.0",
  "identifier": "com.lowyap.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/recordings/**",
            "$APPLOCALDATA/recordings/**"
          ],
          "requireLiteralLeadingDot": true
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": ["resources/**/*", "../LICENSE", "../THIRD-PARTY-NOTICES.md"],
    "license": "MIT",
    "publisher": "lowyap",
    "copyright": "lowyap contributors. Based on Handy by CJ Pais (MIT).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {},
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libgtk-layer-shell0",
          "libopenblas0",
          "libssl3t64 | libssl3"
        ],
        "files": {
          "/usr/lib/lowyap": "transcribe-libs"
        }
      },
      "rpm": {
        "depends": [
          "libgtk-layer-shell.so.0()(64bit)",
          "libopenblas.so.0()(64bit)"
        ],
        "compression": {
          "type": "none"
        },
        "files": {
          "/usr/lib/lowyap": "transcribe-libs"
        }
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/lib": "transcribe-libs"
        }
      }
    },
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwQUJEQTFDOUUzN0M4RTkKUldUcHlEZWVITnFyY0dTMExmRTluQm50L1hZUGQveUN5MGNPbVZxeUl1R0M0dDUyT0VpVU80dzAK",
      "endpoints": [
        "https://github.com/mohdashraf010897/lowyap/releases/latest/download/latest.json"
      ]
    }
  }
}
